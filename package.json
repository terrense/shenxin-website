{
  "name": "ai-systems-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-assets.mjs && tsc -b && vite build && node scripts/generate-seo.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:classes": "node scripts/check-classes.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:render": "node scripts/check-render.mjs",
    "check:keys": "node scripts/check-ui-keys.mjs",
    "check": "npm run check:assets && npm run typecheck && npm run check:contrast && npm run build && npm run check:classes",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.{json,ts,html}\"",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@react-three/fiber": "^9.1.2",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.1",
    "d3-geo": "^3.1.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.7",
    "topojson-client": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.152.0"
  }
}
